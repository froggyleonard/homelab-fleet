# Terraform — state and workdirs never in git
# (.terraform.lock.hcl IS committed — task 014 / ADR 0006: provider checksums
# only, no secrets; pins the exact provider build across seats and rebuilds.)
*.tfstate
*.tfstate.*
*.tfplan
# state-pull archives (task 014 baselines) — full state incl. real addressing;
# they belong in the private orchestrator repo's task artifacts, never here
tf-state-*.json
.terraform/
terraform.tfvars
*.auto.tfvars

# Secrets & keys — only SOPS-encrypted files (*.sops.yaml / *.enc.yaml) belong in git
*.pem
*.key
*.age
age.key
keys.txt
kubeconfig*
*.kubeconfig
!*.sops.yaml
!*.enc.yaml

# Ansible
*.retry
.vault_pass

# Local network identity — real prefix never in git (committed *.example instead)
ansible/inventory/group_vars/all/network.yaml

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
